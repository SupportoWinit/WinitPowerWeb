      <setting name="Files_Input_JSON_Activity_Backup_Path" serializeAs="String">
        <value>~\FilesInputBackupJsonActivity\</value>
      </setting>
      <setting name="Files_Input_Audio_Path" serializeAs="String">
        <value>~\FilesInputClockAppAudio\</value>
      </setting>
      <setting name="Files_Input_Col_Backup_Path" serializeAs="String">
        <value>~\FilesInput\Backup\Col\</value>
      </setting>
      <setting name="Files_Input_Cant_Backup_Path" serializeAs="String">
        <value>~\FilesInput\Backup\Cant\</value>
      </setting>
      <setting name="Files_Input_UserFiles" serializeAs="String">
        <value>~\FilesInput\UserFiles</value>
      </setting>
      <setting name="SegnBackup" serializeAs="String">
        <value>~\FilesInput\Backup\Segnalazioni</value>
      </setting>
      <setting name="SuspendedSegnFile" serializeAs="String">
        <value>Segn_Sospese</value>
      </setting>
      <setting name="ExternalImportConfig" serializeAs="String">
        <value>~\XmlConfig\ExternalOperationsConfig.xml</value>
      </setting>
      <setting name="JsonBackupFileNamePattern" serializeAs="String">
        <value>TmpJsonDownload-{0}-{1}-{2}-{3}-{4}-{5}.txt</value>
      </setting>
      <setting name="SuperUsersFilePath" serializeAs="String">
        <value>~\XmlConfig\SuperUsers.xml</value>
      </setting>
    </Common.Properties.Settings>
  </applicationSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v13.0" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
