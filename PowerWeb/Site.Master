                                                        </td>
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div id="periodTypeSelector" style="float: left; width: 90%; height: 20%; vertical-align: middle; border-top: 1px solid darkgray; margin-top: 10px;">
