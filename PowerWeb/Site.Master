                                                <dx:ASPxLabel runat="server" ID="LblPeriodType" Text="Periodo di competenza" />
                                            </td>
                                            <td style="width: 70%">
                                                <dx:ASPxComboBox runat="server" ID="FldPeriodType" ClientInstanceName="FldPeriodType">
                                                    <ClientSideEvents SelectedIndexChanged="function (s, e) { periodTypeChanged(); }"></ClientSideEvents>
                                                    <Items>
                                                        <dx:ListEditItem Text="Periodo statico" Value="StaticPeriod" />
                                                        <dx:ListEditItem Text="Data corrente" Value="Today" />
                                                        <dx:ListEditItem Text="Data precedente" Value="Yesterday" />
                                                        <dx:ListEditItem Text="Settimana corrente" Value="CurrentWeek" />
                                                        <dx:ListEditItem Text="Settimana precedente" Value="LastWeek" />
                                                        <dx:ListEditItem Text="Mese corrente" Value="CurrentMonth" />
                                                        <dx:ListEditItem Text="Mese precedente" Value="LastMonth" />
                                                        <dx:ListEditItem Text="Mese corrente e precedente" Value="CurrentAndLastMonths" />
                                                        <dx:ListEditItem Text="Anno corrente" Value="CurrentYear" />
                                                        <dx:ListEditItem Text="Anno precedente" Value="LastYear" />
                                                    </Items>
                                                </dx:ASPxComboBox>
                                            </td>
                                        </tr>
                                    </table>
                                    <table id="staticPeriodTable" style="display: none; width: 100%;">
                                        <tr>
                                            <td>
                                                <dx:ASPxLabel runat="server" ID="LblStaticPeriodFrom" Text="Da" />
                                            </td>
                                            <td>
                                                <dx:ASPxDateEdit runat="server" ID="FldStaticPeriodFrom" ClientInstanceName="FldStaticPeriodFrom" />
                                            </td>
                                            <td>
                                                <dx:ASPxLabel runat="server" ID="LblStaticPeriodTo" Text="Al" />
                                            </td>
                                            <td>
                                                <dx:ASPxDateEdit runat="server" ID="FldStaticPeriodTo" ClientInstanceName="FldStaticPeriodTo" />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div id="repetitionSelector" style="float: left; width: 90%; height: 20%; vertical-align: middle; border-top: 1px solid darkgray; margin-top: 10px;">
                                    <table style="margin-top: 10px; width: 100%;">
                                        <tr>
                                            <td>
                                                <dx:ASPxLabel runat="server" ID="LblStartRepetition" Text="Ripeti da" />
                                            </td>
                                            <td>
                                                <dx:ASPxDateEdit runat="server" ID="FldStartRepetitionDate" ClientInstanceName="FldStartRepetitionDate" />
                                            </td>
                                            <td>
                                                <dx:ASPxLabel runat="server" ID="LblEndRepetition" Text="Fino al" />
                                            </td>
                                            <td>
                                                <dx:ASPxDateEdit runat="server" ID="FldEndRepetitionDate" ClientInstanceName="FldEndRepetitionDate" />
                                            </td>
