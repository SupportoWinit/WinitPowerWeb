                                                        </td>
                                                        <td>
                                                            <dx:ASPxCheckBox runat="server" ID="ChkBoxFriday" ClientInstanceName="ChkBoxFriday" Text="Venerdì" ValueType="System.String" ValueChecked="Friday" />
                                                        </td>
                                                        <td>
                                                            <dx:ASPxCheckBox runat="server" ID="ChkBoxSaturday" ClientInstanceName="ChkBoxSaturday" Text="Sabato" ValueType="System.String" ValueChecked="Saturday" />
                                                        </td>
                                                    </tr>
                                                    <tr>
