    [Cant_V].[Cod_Fisc_Can] AS [Cod_Fisc_Can], 
    [Cant_V].[Codice_Cantiere] AS [Codice_Cantiere], 
    [Cant_V].[Codice_Luogo_Nascita_Can] AS [Codice_Luogo_Nascita_Can], 
    [Cant_V].[Codice_Luogo_Residenza_Can] AS [Codice_Luogo_Residenza_Can], 
    [Cant_V].[Codice_Voucher_Can] AS [Codice_Voucher_Can], 
    [Cant_V].[Cognome_Assistito_Can] AS [Cognome_Assistito_Can], 
    [Cant_V].[Contributo_Disabili_Fascia1_Can] AS [Contributo_Disabili_Fascia1_Can], 
    [Cant_V].[Contributo_Disabili_Fascia2_Can] AS [Contributo_Disabili_Fascia2_Can], 
    [Cant_V].[Costo_Mezzora_Prescuola_Can] AS [Costo_Mezzora_Prescuola_Can], 
    [Cant_V].[Costo_Orario_Can] AS [Costo_Orario_Can], 
    [Cant_V].[Data_Isee_Can] AS [Data_Isee_Can], 
    [Cant_V].[Data_Nascita_Can] AS [Data_Nascita_Can], 
    [Cant_V].[Data_Rapporto_Fine_1_Can] AS [Data_Rapporto_Fine_1_Can], 
    [Cant_V].[Data_Rapporto_Fine_2_Can] AS [Data_Rapporto_Fine_2_Can], 
    [Cant_V].[Data_Rapporto_Fine_3_Can] AS [Data_Rapporto_Fine_3_Can], 
    [Cant_V].[Data_Rapporto_Fine_4_Can] AS [Data_Rapporto_Fine_4_Can], 
    [Cant_V].[Data_Rapporto_Fine_5_Can] AS [Data_Rapporto_Fine_5_Can], 
    [Cant_V].[Data_Rapporto_Inizio_1_Can] AS [Data_Rapporto_Inizio_1_Can], 
    [Cant_V].[Data_Rapporto_Inizio_2_Can] AS [Data_Rapporto_Inizio_2_Can], 
    [Cant_V].[Data_Rapporto_Inizio_3_Can] AS [Data_Rapporto_Inizio_3_Can], 
    [Cant_V].[Data_Rapporto_Inizio_4_Can] AS [Data_Rapporto_Inizio_4_Can], 
    [Cant_V].[Data_Rapporto_Inizio_5_Can] AS [Data_Rapporto_Inizio_5_Can], 
    [Cant_V].[Data_Registrazione_Can] AS [Data_Registrazione_Can], 
    [Cant_V].[DataOraUltimaModifica_Can] AS [DataOraUltimaModifica_Can], 
