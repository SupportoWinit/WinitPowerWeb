          <EntitySet Name="Cant_V" EntityType="Self.Cant_V" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [Cant_V].[Cant_Id] AS [Cant_Id], 
    [Cant_V].[Arrot_Durata_Can] AS [Arrot_Durata_Can], 
    [Cant_V].[Canone_Mensile_Fascia1_Can] AS [Canone_Mensile_Fascia1_Can], 
